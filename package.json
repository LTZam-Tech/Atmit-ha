{
  "name": "qa-playwright-framework",
  "version": "0.1.0",
  "description": "atimtha · أتمتها — Automation Studio. You imagine. We automate.",
  "type": "module",
  "private": true,
  "scripts": {
    "demo": "node demo-app/server.js",
    "panel": "tsx panel/server.ts",
    "page:open": "tsx scripts/open-page.ts",
    "page:capture": "tsx scripts/capture-page.ts",
    "record": "tsx scripts/record.ts",
    "or:types": "tsx scripts/generate-or-types.ts",
    "or:validate": "tsx scripts/generate-or-types.ts --check",
    "or:harvest": "tsx scripts/or-harvester.ts",
    "pretest": "npm run or:types",
    "test": "playwright test",
    "test:headed": "cross-env SLOWMO=400 playwright test --headed --workers=1",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:video": "cross-env VIDEO=on playwright test",
    "test:positive": "playwright test --grep @positive",
    "test:negative": "playwright test --grep @negative",
    "test:smoke": "playwright test --grep @smoke",
    "report": "node -e \"import('node:child_process').then(c=>c.exec((process.platform==='win32'?'start ':'open ')+'reports/smart-report/index.html'))\"",
    "report:debug": "playwright show-report reports/playwright-html",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/generate-or-types.ts --check",
    "test:ar": "cross-env LOCALE=ar playwright test"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.63.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.5",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "htm": "^3.1.1",
    "preact": "^10.29.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}