# Atimtha production settings. Copy to .env.prod, fill in every value, keep the file readable by root only
# (chmod 600 .env.prod). Never commit it.

# version of the images (docker load from the offline bundle, or your registry)
ATIMTHA_VERSION=1.0.0
ATIMTHA_REGISTRY=atimtha

# database (long random values: openssl rand -base64 32)
POSTGRES_PASSWORD=
ATIMTHA_OWNER_PASSWORD=
ATIMTHA_APP_PASSWORD=

# the address people open (behind your TLS reverse proxy), used in links in reports, notifications and issues
ATIMTHA_PUBLIC_URL=https://atimtha.example.org
# people who may create, rename and archive organisations (comma-separated emails)
ATIMTHA_PLATFORM_ADMINS=
# bearer token Prometheus sends to /metrics: openssl rand -hex 24 (empty = metrics only from inside the container)
ATIMTHA_METRICS_TOKEN=
# where the web container listens on this host (your reverse proxy forwards to it)
ATIMTHA_HTTP_BIND=127.0.0.1
ATIMTHA_HTTP_PORT=8080

# identity provider (OIDC): the issuer address, the API audience and the web app's client id
ATIMTHA_OIDC_ISSUER=https://idp.example.org/realms/atimtha
ATIMTHA_OIDC_AUDIENCE=atimtha-api
ATIMTHA_OIDC_CLIENT_ID=atimtha-web

# job signing key (ECDSA P-256, PEM on one line with \n): agents verify every job with it
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | awk '{printf "%s\\n", $0}'
# its public half (for agents that pin the key, ATIMTHA_JOB_PUBLIC_KEY):
#   openssl ec -in key.pem -pubout
ATIMTHA_JOB_SIGNING_KEY=
ATIMTHA_JOB_PUBLIC_KEY=
# job token key (32 bytes, base64): test runners report with short-lived tokens signed by it: openssl rand -base64 32
ATIMTHA_JOB_TOKEN_KEY=

# evidence encryption key (32 bytes, base64): openssl rand -base64 32
# keep a copy in a safe place: without it, stored screenshots, videos and reports cannot be read
ATIMTHA_EVIDENCE_KEY=

# secrets that integrations reference (vault:env/NAME); leave empty when unused
JIRA_TOKEN=
AZURE_DEVOPS_PAT=
TESTRAIL_API_KEY=
SLACK_WEBHOOK_URL=

# optional on-host agent (--profile agent): its token from Agents → New agent
ATIMTHA_AGENT_TOKEN=
