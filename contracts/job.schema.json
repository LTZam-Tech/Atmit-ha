{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atimtha.iltizamtech/contracts/job/1",
  "title": "Atimtha job v1 (ADR-0014): what an agent receives when it claims work",
  "description": "Data only: there is no field naming a program or a command. Secrets travel as references.",
  "type": "object",
  "required": ["contract", "jobId", "executionId", "organizationId", "engine", "project", "environment", "selection", "settings", "expiresAt"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "atimtha.job/1" },
    "jobId": { "type": "string", "format": "uuid" },
    "executionId": { "type": "string", "format": "uuid" },
    "organizationId": { "type": "string", "format": "uuid" },
    "engine": { "enum": ["web", "api", "mobile", "performance"] },
    "kind": { "enum": ["run", "explore", "export"], "default": "run", "description": "run: the tests; explore: collect pages as drafts; export: standalone Playwright code" },
    "explore": {
      "type": "object",
      "required": ["urls"],
      "additionalProperties": false,
      "properties": {
        "urls": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string" }, "description": "paths, or addresses on the environment's host" },
        "as": { "type": ["string", "null"], "description": "test user to sign in as first" }
      }
    },
    "shard": {
      "type": "object",
      "required": ["index", "total"],
      "additionalProperties": false,
      "properties": { "index": { "type": "integer", "minimum": 1, "maximum": 8 }, "total": { "type": "integer", "minimum": 2, "maximum": 8 } }
    },
    "project": { "$ref": "https://atimtha.iltizamtech/contracts/project-snapshot/1" },
    "environment": {
      "type": "object",
      "required": ["key", "baseURL"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "baseURL": { "type": "string", "format": "uri" },
        "secretRefs": {
          "type": "object",
          "description": "secret path (users.<key>.password, environments.<key>.httpCredentials.password) → secrets-manager reference",
          "additionalProperties": { "type": "string", "pattern": "^vault:" }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cases": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "suite": { "type": ["string", "null"] },
        "grep": { "type": ["string", "null"] },
        "flows": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": { "enum": ["en", "ar"] },
        "workers": { "type": "integer", "minimum": 1, "maximum": 16 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 3 },
        "healing": { "enum": ["pass", "flag", "off"] },
        "testTimeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 900 },
        "seed": { "type": "integer" },
        "maxVirtualUsers": { "type": "integer", "minimum": 0, "description": "performance runs: the organisation's load cap" }
      }
    },
    "expiresAt": { "type": "string", "format": "date-time" },
    "agentId": { "type": "string", "format": "uuid", "description": "the agent that claimed the job (signed with it)" },
    "jobToken": { "type": "string", "pattern": "^ajt_", "description": "short-lived token for this job only: events, evidence, artifacts" },
    "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$", "description": "the platform request's trace; logged by the agent and sent back as traceparent" }
  }
}
