{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@pages/*": ["src/pages/*"],
      "@data/*": ["src/data/*"],
      "@utils/*": ["src/utils/*"],
      "@fixtures": ["src/fixtures/index.ts"],
      "@config/*": ["config/*"],
      "@apps/*": ["apps/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "reports"]
}
